# FeedQuality AI — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Server Configuration
PORT=5000
FLASK_ENV=production
DEBUG=False

# Security & QR Verification
# Set a strong random secret key in production for cryptographic QR signatures
QR_SECRET_KEY=feedquality-secret-key-sih26111-production

# File Upload Limits
# Maximum upload size in megabytes (default: 5MB)
MAX_UPLOAD_SIZE_MB=5

# CORS Configuration
# Comma-separated list of allowed origins (or * for all in development)
CORS_ORIGINS=*
