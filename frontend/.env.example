# Copy to frontend/.env.local for local overrides; on Netlify set these in Site settings → Environment variables.

# Full URL of the deployed Flask API, including /api. Leave unset to use same-origin /api (local dev proxy / Vercel).
VITE_API_BASE=https://your-backend.example.com/api

# Optional: enables Supabase auth; without them the app uses browser-local accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
